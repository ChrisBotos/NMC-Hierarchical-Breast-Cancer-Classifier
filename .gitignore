# ===== Run outputs =====
# Only curated summary tables and figures from the two headline runs are tracked.
# Everything a run regenerates stays out: per-fold GridSearchCV score tables,
# per-repeat fold results, monolithic raw-fold CSVs, and cluster logs.
results/**/fold_details/
results/**/all_fold_results.csv
results/**/fold_results_*_r*.csv
results/**/logs/
*.log

# ===== Model artifacts =====
# model.pkl is roughly 1 MB of pickled sklearn state and is regenerated by
# code/final_training.py.
model/model.pkl

