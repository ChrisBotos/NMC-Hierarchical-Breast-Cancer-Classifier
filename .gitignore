# TB-Project (CATS) .gitignore

# ===== IDE =====
.idea/
.vscode/
.cursor/
*.swp
*.swo

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg

# ===== Virtual Environments =====
venv*/
.venv/
ENV/
env/

# ===== Testing =====
.pytest_cache/
.coverage
htmlcov/

# ===== Jupyter =====
.ipynb_checkpoints/

# ===== Claude Code =====
.claude/
CLAUDE.md
.claudeignore

# ===== Internal planning =====
docs/research_plan.md

# ===== Data (keep structure, ignore contents) =====
data/**/*
!data/**/
!data/**/.gitkeep

# ===== Results (keep structure, ignore contents) =====
results/**/*
!results/**/
!results/**/.gitkeep
!results/**/config.json
!results/**/report.md
!results/2026-04-22_server_run_flat_nested_CV/**
!results/2026-04-22_server_run_hierarchical_nested_CV/**
!results/2026-04-24_server_run_v2/**
!results/2026-04-25_final_hierarchical/**
!results/2026-05-10_pens_plateau_comparison/**

# ===== Interesting results (keep findings.md, ignore supporting files) =====
interesting_results/*
!interesting_results/.gitkeep
!interesting_results/findings.md

# ===== Model artifacts =====
model/model.pkl

# ===== OS Files =====
.DS_Store
Thumbs.db

# ===== Archives =====
*.zip
*.tar.gz
*.rar
/.claudeignore

# ===== Notebooks (keep structure, ignore outputs) =====
notebooks/*.html
/reports/latex_draft_report/temp_report_changes
